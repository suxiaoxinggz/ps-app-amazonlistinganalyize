# .env file
# 此文件应放在服务器项目根目录，与 docker-compose.yml 同级
# 安全起见，请不要将此文件提交到 Git 仓库

# AI 网关密钥 (您自己定义的密钥，用于保护 API)
GATEWAY_API_KEY=your_secret_key_here

# 管理员密码 (用于清空所有项目数据)
ADMIN_PASSWORD=your_admin_password_here

# 对外统一入口端口：1Panel / Nginx 只需要反代到这个端口
APP_PORT=18080

# 后端容器内部端口 (通常不需要改)
PORT=8723

# 前端浏览器访问后端的地址（构建前端时注入）
# 留空 = 使用同源反代：当前域名的 /upload /analyze /api/* /project/* 等转发到后端
# 如果后端使用独立域名，再填写例如：https://api.example.com
NEXT_PUBLIC_API_URL=

# 后端允许跨域访问的前端来源，多个用英文逗号分隔
# 同源反代部署通常不用改；分域部署时填写前端域名，例如：https://app.example.com
BACKEND_CORS_ORIGINS=http://localhost:3179

# 本地向量/网关模型配置
# BGE small 比 all-MiniLM-L6-v2 效果更好，仍然轻量，维度同为 384
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_NORMALIZE=true
# 仅 /gateway/v1/sentiment 使用；保持小模型，避免额外资源占用
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
